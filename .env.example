# Vercel project environment variable (public; embedded during npm run build):
MULTIPLAYER_URL=https://your-multiplayer-service.onrender.com

# Backend service environment variable (comma-separated exact frontend origins):
ALLOWED_ORIGINS=https://your-game.vercel.app

# This file is documentation. npm start/build read process environment variables;
# they do not load .env automatically. Set these in the hosting dashboards.
